{
  "name": "@gdp/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Pay Me Back client logic: typed API client, React Query hooks, money/QR/payout helpers.",
  "type": "module",
  "exports": {
    "./api": "./src/api/index.ts",
    "./api/*": "./src/api/*.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../../apps/api/openapi.yaml -o src/api/schema.d.ts",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.9",
    "heic2any": "^0.0.4",
    "js-sha256": "^0.11.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@vitest/coverage-v8": "^4.1.12",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
